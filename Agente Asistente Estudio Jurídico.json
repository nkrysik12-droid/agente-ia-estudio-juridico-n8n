      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Consulta la base de conocimiento del Estudio Jurídico Integral para recuperar información sobre servicios jurídicos disponibles, preguntas frecuentes y políticas de atención y derivación. Utiliza esta herramienta antes de responder consultas sobre el estudio. No inventes información que no esté respaldada por los documentos recuperados.",
        "tableName": {
          "__rl": true,
          "value": "documents",
          "mode": "list",
          "cachedResultName": "documents"
        },
        "options": {}
      },
