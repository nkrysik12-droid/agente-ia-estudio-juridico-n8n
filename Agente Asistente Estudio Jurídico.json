    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  try {\n    let datos = item.json.output;\n\n    if (typeof datos === 'string') {\n      datos = datos\n        .replace(/```json\\s*/gi, '')\n        .replace(/```\\s*/g, '')\n        .trim();\n\n      datos = JSON.parse(datos);\n    }\n\n    const acciones = [\n      'RESPONDER',\n      'SOLICITAR_INFORMACION',\n      'DERIVAR'\n    ];\n\n    const areas = [\n      'Laboral',\n      'Familia',\n      'Civil',\n      'No determinada',\n      'Fuera de alcance'\n    ];\n\n    if (\n      !datos ||\n      typeof datos !== 'object' ||\n      Array.isArray(datos) ||\n      !acciones.includes(datos.accion) ||\n      !areas.includes(datos.area) ||\n      typeof datos.motivo !== 'string' ||\n      !datos.motivo.trim() ||\n      typeof datos.respuesta !== 'string' ||\n      !datos.respuesta.trim() ||\n      typeof datos.requiere_revision_humana !== 'boolean'\n    ) {\n      throw new Error('Respuesta IA inválida');\n    }\n\n    // Controlar coherencia de la derivación\n    if (\n      datos.requiere_revision_humana !==\n      (datos.accion === 'DERIVAR')\n    ) {\n      throw new Error('Decisión de revisión inconsistente');\n    }\n\n    return {\n      json: {\n        ...datos,\n        validacion: 'OK'\n      }\n    };\n\n  } catch (error) {\n    return {\n      json: {\n        accion: 'DERIVAR',\n        area: 'No determinada',\n        motivo: 'Error de validación: ' + error.message,\n        respuesta: 'Recibimos su consulta. Un integrante del estudio deberá revisarla antes de responder.',\n        requiere_revision_humana: true,\n        validacion: 'ERROR'\n      }\n    };\n  }\n});\n"
      },
